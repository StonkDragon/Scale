cdecl "strtoll"
private expect foreign unsafe function __c_strtoll(:[int8], :*[int8], :int): int64
cdecl "strtoull"
private expect foreign unsafe function __c_strtoull(:[int8], :*[int8], :int): uint64

cdecl "snprintf"
private expect foreign unsafe function __c_snprintf(:[int8], :int, :[int8], :varargs): int

final static struct int
  (0x7fffffffffffffffi) => decl minValue: const int
  (0x8000000000000000i) => decl maxValue: const int

  function toString(x: int): str
    new<int8>[32] => decl out: [int8]
    unsafe
      out 31 c"%ld" varargs x __c_snprintf drop
    end
    out:resizeToFit str::new return
  end

  function toHexString(x: int): str
    new<int8>[32] => decl out: [int8]
    unsafe
      out 31 c"0x%016lx" varargs x __c_snprintf drop
    end
    out:resizeToFit str::new return
  end

  function parse(s: str): int               unsafe s:view nil as *[int8] 0 __c_strtoll return end end
  function asReference(i: int): Box<int>  Box<int> { i => value } return end
  function =>(x: float): int                x as int return end
  function =>(x: float32): int              x as int return end
end

