framework: {
    version: "24.2.0";
    headerDir: "include";
    implDir: "impl";
    implementers: [
        "scale.c";
    ];
    implHeaderDir: "impl";
    implHeaders: [];
    modules: {
        std: [ # This module is automatically imported by the compiler
            "std/Core.scale";
            "std/String.scale";
            "std/SclObject.scale";
            "std/Debug.scale";
            "std/Int.scale";
            "std/Any.scale";
            "std/Float.scale";
            "std/Union.scale";
            "std/List.scale";
            "std/StaticArray.scale";
        ];
    };
    build: {
        arguments: [
            "-no-link-std";
        ];
    };
};
